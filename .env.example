# Application
APP_NAME=CoreCoder RAG API

# LLM and Embedding
ALI_API_KEY=replace-with-your-dashscope-api-key
LLM_MODEL=qwen3.7-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Knowledge base
KNOWLEDGE_DIR=knowledge
MAX_UPLOAD_SIZE_MB=20
RAG_TOP_K=5
RAG_MAX_TOP_K=10
RAG_SCORE_THRESHOLD=0.25
KNOWLEDGE_STORAGE_DIR=knowledge

# Agent
AGENT_MAX_ROUNDS=15
AGENT_MAX_CONTEXT_TOKENS=128000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=corecoder